title           = TIP4P Water Slab Energy Minimization

; Run Control
integrator      = steep
nsteps          = 50000
dt              = 0.001

; Energy Minimization
emtol           = 100.0
emstep          = 0.01

; Neighbor Searching
cutoff-scheme   = Verlet
nstlist         = 20
pbc             = xyz
rlist           = 1.0

; Electrostatics
coulombtype     = PME
rcoulomb        = 1.0

; Van der Waals
vdwtype         = Cut-off
rvdw            = 1.0
vdw-modifier    = Potential-shift-Verlet

; Ewald
ewald-geometry  = 3dc

constraints     = none