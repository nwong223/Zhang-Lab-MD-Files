; Run Control
integrator  = steep
nsteps      = 25000
dt          = 0.001

; Energy Minimization
emtol       = 100.0
emstep      = 0.01

; Neighbor Searching
cutoff-scheme = Verlet
pbc           = xyz
nstlist       = 10

; Electrostatics
coulombtype = PME
rcoulomb    = 1.0

; Van der Waals
vdwtype     = Cut-off
rvdw        = 1.0

; Ewald
ewald-geometry = 3d

; Constraints
constraints = none
